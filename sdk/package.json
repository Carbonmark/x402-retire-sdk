{
  "name": "@carbonmark/x402-retire",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Zero-dependency TypeScript client for retiring tokenized carbon credits on Base through the x402 Carbon Retirement API, with a public Carbonmark certificate for every retirement.",
  "keywords": [
    "carbon",
    "carbon-credits",
    "carbon-retirement",
    "carbon-offset",
    "carbonmark",
    "x402",
    "base",
    "usdc",
    "ai-agents",
    "eip-3009"
  ],
  "homepage": "https://docs.carbonmark.com/carbonmark-x402/carbonmark-x402",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KlimaDAO/Klima-Protocol-x402-MCP-documentation.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/KlimaDAO/Klima-Protocol-x402-MCP-documentation/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/x402-retire.d.ts",
      "default": "./dist/x402-retire.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/x402-retire.d.ts",
  "files": [
    "dist",
    "x402-retire.ts",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test x402-retire.test.ts scripts/release-guard.test.mjs",
    "changelog:check": "node scripts/changelog-check.mjs",
    "prepack": "npm run changelog:check && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2"
  }
}
